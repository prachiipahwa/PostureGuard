# PostureGuard AI — Environment Configuration
# Copy this file to .env and fill in your values

# ── Groq API Key (FREE — no billing required) ─────────────────────────────
# Get yours free at: https://console.groq.com/
# Click "API Keys" → "Create API Key" — takes 30 seconds, no credit card
# Used for: AI 7-day plan generation, live AI coaching tips
GROQ_API_KEY=gsk_YOUR_KEY_HERE

# ── (Optional) Override the default model ─────────────────────────────────
# Default: llama-3.3-70b-versatile  (fast, free, great quality)
# Other free options:
#   llama-3.1-8b-instant   (fastest, lighter)
#   mixtral-8x7b-32768     (good for longer outputs)
# GROQ_MODEL=llama-3.3-70b-versatile

# ── App settings ──────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-string
PORT=5000
DEBUG=false
